        }
      }
    },
    "Your data never leaves your device. No account, no cloud, no tracking. bloom is open source, so anyone can check this." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten verlassen nie dein Gerät. Kein Konto, keine Cloud, kein Tracking. bloom ist Open Source, also kann das jede Person überprüfen."
          }
        }
      }
    },
    "bloom is not a contraceptive and does not replace medical advice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bloom ist kein Verhütungsmittel und ersetzt keine ärztliche Beratung."
          }
        }
      }
    },
    "bloom is not a contraceptive and does not replace medical advice. Predictions are estimates and can be wrong." : {
